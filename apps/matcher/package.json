    "match:evaluate": "tsx src/evaluate.ts"
  },
  "dependencies": {
    "@sonic/core": "workspace:*",
    "@sonic/shared": "workspace:*",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
