# Copy to .env and fill in. Used by docker-compose and the server.

# --- Database ---
DATABASE_URL=postgres://sonic:sonic@localhost:5432/sonic
POSTGRES_USER=sonic
POSTGRES_PASSWORD=sonic
POSTGRES_DB=sonic

# --- Auth (single user) ---
JWT_SECRET=change-me-to-a-long-random-string
AUTH_USERNAME=owner
# bcrypt hash of your password — generate with: pnpm --filter @sonic/server hash-password "yourpw"
AUTH_PASSWORD_HASH=

# --- Storage ---
STORAGE_DRIVER=disk
IMAGE_DIR=/data/images

# --- Metadata sources ---
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=Sonic/0.1 +https://example.com

# --- Vision (recognition fallback) ---
VISION_DRIVER=claude
ANTHROPIC_API_KEY=
# when VISION_DRIVER=ollama:
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2-vl

# --- Web (baked at build time) ---
VITE_API_URL=http://localhost:3005
