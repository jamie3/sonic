# Copy to .env and fill in. Used by docker-compose and the server.

# --- Database ---
# Sonic's Postgres (docker compose service `db`) is published on POSTGRES_PORT, default 5433.
DATABASE_URL=postgres://sonic:sonic@localhost:5433/sonic
POSTGRES_USER=sonic
POSTGRES_PASSWORD=sonic
POSTGRES_DB=sonic

# --- Accounts (Better Auth) ---
# Signs session cookies. A long random string (≥32 chars for BETTER_AUTH_SECRET;
# if that's unset, a key is derived from JWT_SECRET).
JWT_SECRET=change-me-to-a-long-random-string
# BETTER_AUTH_SECRET=
# Public URL of the app (origin checks). Defaults to http://localhost:3005.
# BETTER_AUTH_URL=https://sonic.example.com
# Accounts live in the database. Sign-up is invite-only: the first account on a
# fresh install needs no invite; after that, create codes on the Profile page
# or with `pnpm invite:create`.

# --- Storage ---
STORAGE_DRIVER=disk
IMAGE_DIR=/data/images

# --- Metadata sources ---
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=Sonic/0.1 +https://example.com

# --- Vision (recognition fallback) ---
VISION_DRIVER=claude
ANTHROPIC_API_KEY=
# when VISION_DRIVER=ollama:
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2-vl

# Built web app served by the API. Leave unset locally (defaults to apps/web/dist);
# the Docker image sets it.
# WEB_DIR=

# Serve OpenAPI docs at /api/docs (default: on unless NODE_ENV=production)
# API_DOCS=true
