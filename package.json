{
  "name": "sonic",
  "private": true,
  "version": "0.0.0",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "docker compose up -d --wait db && concurrently -k -n api,matcher,extract,web -c blue,magenta,yellow,green \"pnpm:dev:server\" \"pnpm:dev:matcher\" \"pnpm:dev:extractor\" \"pnpm:dev:web\"",
    "dev:server": "pnpm --filter @sonic/server dev",
    "dev:matcher": "pnpm --filter @sonic/matcher dev",
    "dev:extractor": "pnpm --filter @sonic/extractor dev",
    "dev:web": "pnpm --filter @sonic/web dev",
    "dev:mobile": "pnpm --filter @sonic/mobile start",
    "db:migrate": "pnpm --filter @sonic/core db:migrate",
    "db:seed": "pnpm --filter @sonic/core db:seed",
    "db:reset": "pnpm --filter @sonic/core db:reset",
    "discogs:import": "pnpm --filter @sonic/discogs run import",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "trash:purge": "pnpm --filter @sonic/matcher trash:purge",
    "releases:fill-details": "pnpm --filter @sonic/core releases:fill-details",
    "match:evaluate": "pnpm --filter @sonic/matcher match:evaluate",
    "invite:create": "pnpm --filter @sonic/core invite:create"
  },
  "devDependencies": {
    "concurrently": "^9"
  }
}
